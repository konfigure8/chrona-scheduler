{
  "compilerOptions": {
    "lib": ["ES2020"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "noEmit": false,
    "noUncheckedIndexedAccess": true,
    "outDir": "../out/tests",
    "rootDir": "..",
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2019"
  },
  "include": [
    "../src/coverage.ts",
    "../src/decorations.ts",
    "../src/interactions.ts",
    "../src/monthLayout.ts",
    "../src/rosterLayout.ts",
    "../src/preferences.ts",
    "../src/resourcePreferences.ts",
    "../src/rowVirtualization.ts",
    "../src/skills.ts",
    "../src/spans.ts",
    "../src/stringResources.ts",
    "../src/tagColors.ts",
    "../src/theme.ts",
    "../src/timeAxis.ts",
    "../src/timeZone.ts",
    "../src/timelineLayout.ts",
    "../src/types.ts",
    "../src/undoRedo.ts",
    "../src/viewConfig.ts",
    "./*.spec.ts"
  ]
}
