{
  "compilerOptions": {
    "esModuleInterop": true,
    "lib": [
      "ES2020",
      "DOM"
    ],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "noEmit": false,
    "noUncheckedIndexedAccess": true,
    "outDir": "../out-unit",
    "rootDir": "..",
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2019",
    "types": [
      "node",
      "powerapps-component-framework"
    ]
  },
  "include": [
    "../SchedulerControl/controlStrings.ts",
    "../SchedulerControl/dataverseData.ts",
    "../SchedulerControl/configLoader.ts",
    "./*.spec.ts"
  ]
}
